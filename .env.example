# Standalone CLI configuration. Copy to .env, edit, then run sqliteadmin.
# Command flags override environment variables. Exported variables override .env.
SQLITEADMIN_DB=./app.db
SQLITEADMIN_ADDR=127.0.0.1:8081
SQLITEADMIN_READ_ONLY=false
SQLITEADMIN_USER=admin
SQLITEADMIN_PASSWORD='choose-a-password'

# Optional local backup folder (default: <database path>.backups/):
# SQLITEADMIN_BACKUP_DIR=./backups

# Enable S3 by setting all four required values:
# SQLITEADMIN_S3_ENDPOINT=https://your-s3-endpoint.example
# SQLITEADMIN_S3_BUCKET=database-backups
# SQLITEADMIN_S3_ACCESS_KEY_ID='your-access-key'
# SQLITEADMIN_S3_SECRET_ACCESS_KEY='your-secret-key'
# Optional, only when S3 is configured:
# SQLITEADMIN_S3_REGION=us-east-1
# SQLITEADMIN_S3_PREFIX=sqliteadmin/app.db/
# SQLITEADMIN_S3_SESSION_TOKEN='your-temporary-session-token'
